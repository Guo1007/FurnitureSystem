# ========== AI 配置 ==========
# 通义千问 API Key（AI 聊天功能必需）
CHAT_AI_API_KEY=sk-your-api-key-here
EMBEDDING_KEY=sk-your-embedding-key-here

# ========== 阿里云 OSS ==========
# 图片上传必需
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY=your-access-key
OSS_SECRET_KEY=your-secret-key
OSS_BUCKET=your-bucket-name
OSS_URL=https://your-bucket.oss-cn-beijing.aliyuncs.com

# ========== MySQL ==========
MYSQL_ROOT_PASSWORD=root

# ========== 邮件（验证码功能）==========
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-mail-auth-code

# ========== RocketMQ ==========
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876

# ========== 支付宝支付（沙箱） ==========
# 预下单/回调必需。沙箱应用私钥与支付宝公钥在开放平台沙箱后台获取。
ALIPAY_APP_ID=your-sandbox-app-id
ALIPAY_APP_PRIVATE_KEY=your-sandbox-app-private-key
ALIPAY_ALIPAY_PUBLIC_KEY=your-sandbox-alipay-public-key
# 异步回调地址，必须是公网 HTTPS。走现有 /api/ 反代，故取 /api/payment/notify
ALIPAY_NOTIFY_URL=https://mingcheng.asia/api/payment/notify
# 网关默认已在 application.yml 写死为沙箱地址；如需覆盖再填，一般不用设。
#ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
